// Generated by CMake from cmake/app.rc.in. Version information and, when the
// user's local original icon exists, icon resource 1 (see tools/make_icon.py).
#include <winver.h>
@NOVA_RC_ICON@
VS_VERSION_INFO VERSIONINFO
FILEVERSION @NOVA_VERSION_COMMA@
PRODUCTVERSION @NOVA_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@NOVA_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@NOVA_RC_NAME@"
            VALUE "OriginalFilename", "@NOVA_RC_NAME@.exe"
            VALUE "ProductName", "N.O.V.A. 3 PC"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "Unofficial fan port. N.O.V.A. 3 is a trademark of Gameloft."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
